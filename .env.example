# Copy this file to .env (next to agent.py) and adjust it.
# Variables set in the shell take precedence over values from .env.

# Address of an OpenAI-compatible model server.
# Docker Model Runner: http://localhost:12434/engines/v1
# Ollama:              http://localhost:11434/v1
# llama.cpp server:    http://localhost:8080/v1
# LM Studio:           http://localhost:1234/v1
MODEL_BASE_URL=http://localhost:12434/engines/v1

# Model that writes the answers.
MODEL=huggingface.co/ggml-org/qwen3.8-27b-gguf:Q4_K_M

# Embedding model for semantic search.
EMBED_MODEL=huggingface.co/qwen/qwen3-embedding-0.6b-gguf:Q8_0

# Folder with your projects (optional). If set, a project can be given
# relative to it: python3 agent.py "My project"
PROJECTS_DIR=
